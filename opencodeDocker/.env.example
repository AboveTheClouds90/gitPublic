# Copy to .env and edit. Use forward slashes in Windows paths.
# No API keys here: they come from your Windows environment variables.

# Folder that contains your projects, mounted as /workspace
WORKSPACE_DIR=C:/code

# Subfolder of WORKSPACE_DIR that OpenCode starts in
PROJECT=my-app

# Folder that contains your opencode.json (default: .\config next to the compose file)
# CONFIG_DIR=D:/KI/docker/config

# OPENCODE_VERSION=2.0.6
